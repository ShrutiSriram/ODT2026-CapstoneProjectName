#  PIN DEFINITIONS

# Push button (active LOW with internal pull-up)
pb          = Pin(4,  Pin.IN, Pin.PULL_UP)
  
# Laser module
laser       = Pin(5,  Pin.OUT)

# LDR (digital output — LOW = beam detected)
ldr         = Pin(34, Pin.IN)

# LED strips — 3x WS2812B strips (8 LEDs each = 24 total)
STRIP_PIN   = 15
NUM_STRIP   = 24
strip       = neopixel.NeoPixel(Pin(STRIP_PIN), NUM_STRIP)

# Buzzer (PWM)
BUZZER_PIN  = 21
buzzer      = PWM(Pin(BUZZER_PIN))
buzzer.duty(0)

# NeoPixel ring — 16 LEDs
RING_PIN    = 16
NUM_RING    = 16
ring        = neopixel.NeoPixel(Pin(RING_PIN), NUM_RING)

# Motor 1 — CW 3s → ACW 3s  (L298N channel A)
m1_in1      = Pin(25, Pin.OUT)
m1_in2      = Pin(26, Pin.OUT)
m1_ena      = PWM(Pin(33), freq=100)

# Motor 2 — CW full 20s  (separate L298N)
m2_in1      = Pin(22, Pin.OUT) 
m2_in2      = Pin(23, Pin.OUT)
m2_ena      = PWM(Pin(13), freq=100)

# ─────────────────────────────────────────
#  TUNING CONSTANTS
# ─────────────────────────────────────────

# How long Motor 1 runs in each direction (one rotation CW, one ACW).
# Adjust this until one full rotation looks right on your hardware.
MOTOR1_ROTATION_MS = 1000   # milliseconds per direction

