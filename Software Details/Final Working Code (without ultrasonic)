#  HELPER FUNCTIONS
# ─────────────────────────────────────────

def serve_web():
    """Try to serve a web request without blocking. Call this frequently."""
    try:
        conn, addr = server.accept()
        print("Client connected from", addr)
        conn.recv(1024)
        conn.send("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nConnection: close\r\n\r\n")
        conn.sendall(html)
        conn.close()
    except OSError:
        pass  # No client waiting — that's fine


# ── LED strip helpers ──

def strip_set_all(r, g, b):
    for i in range(NUM_STRIP):
        strip[i] = (r, g, b)
    strip.write()

def strip_clear():
    strip_set_all(0, 0, 0)


# ── Buzzer helpers ──

def tone(freq, duration_ms):
    buzzer.freq(freq)
    buzzer.duty(512)
    time.sleep_ms(duration_ms)
    buzzer.duty(0)

def buzzer_off():
    buzzer.duty(0)


# ── NeoPixel ring helpers ──

def ring_clear():
    for i in range(NUM_RING):
        ring[i] = (0, 0, 0)
    ring.write()

def ring_fill_cw(duration_s):
    """Light up LEDs one by one clockwise. duration_s can be fractional or use ring_fill_cw_ms."""
    delay = max(1, (int(duration_s * 1000)) // NUM_RING)
    for i in range(NUM_RING):
        ring[i] = (255, 0, 0)
        ring.write()
        time.sleep_ms(delay)

def ring_drain_acw(duration_s):
    """Turn off LEDs one by one anticlockwise."""
    delay = max(1, (int(duration_s * 1000)) // NUM_RING)
    for i in range(NUM_RING - 1, -1, -1):
        ring[i] = (0, 0, 0)
        ring.write()
        time.sleep_ms(delay)

def ring_fill_cw_ms(duration_ms):
    """Light up LEDs one by one clockwise over duration_ms milliseconds."""
    delay = max(1, duration_ms // NUM_RING)
    for i in range(NUM_RING):
        ring[i] = (255, 0, 0)
        ring.write()
        time.sleep_ms(delay)

def ring_drain_acw_ms(duration_ms):
    """Turn off LEDs one by one anticlockwise over duration_ms milliseconds."""
    delay = max(1, duration_ms // NUM_RING)
    for i in range(NUM_RING - 1, -1, -1):
        ring[i] = (0, 0, 0)
        ring.write()
        time.sleep_ms(delay)


# ── Motor helpers ──

def motor1_cw():
    m1_in1.value(1)
    m1_in2.value(0)
    m1_ena.duty_u16(65535)   # half speed

def motor1_acw():
    m1_in1.value(0)
    m1_in2.value(1)
    m1_ena.duty_u16(65535)   # half speed

def motor1_stop():
    m1_in1.value(0)
    m1_in2.value(0)
    m1_ena.duty_u16(0)

def motor2_cw():
    m2_in1.value(1)
    m2_in2.value(0)
    m2_ena.duty_u16(65535)   # half speed

def motor2_stop():
    m2_in1.value(0)
    m2_in2.value(0)
    m2_ena.duty_u16(0)


# ── Full LED + buzzer light show ──

def run_light_show():
    """Plays the blue fade-in, portal pulse pattern, flashes and ready beeps."""

    # Blue fade-in with rising tone
    for b in range(0, 255, 5):
        strip_set_all(0, 0, b)
        buzzer.freq(300 + b * 2)
        buzzer.duty(300)
        time.sleep_ms(25)
    buzzer_off()

    # Portal pulse — blue ↔ purple x3
    for _ in range(3):
        for step in range(0, 50, 2):
            strip_set_all(step * 2, 0, 255 - step)
            buzzer.freq(500 + step * 10)
            buzzer.duty(200)
            time.sleep_ms(18)
        for step in range(50, 0, -2):
            strip_set_all(step * 2, 0, 255 - step)
            buzzer.freq(500 + step * 10)
            buzzer.duty(200)
            time.sleep_ms(18)
    buzzer_off()

    # Two white flashes with sharp beep
    for _ in range(2):
        strip_set_all(255, 255, 255)
        tone(2000, 120)
        strip_clear()
        time.sleep_ms(80)

    strip_clear()

    # Ready beeps — two ascending tones
    tone(1000, 100)
    time.sleep_ms(100)
    tone(1200, 100)


# ── Warning beeps at second 17 ──

def run_warning_beeps():
    """Repeats light show pattern briefly + 3 beeps (1 per second) for 3s warning."""
    # Quick flash to signal warning
    for _ in range(3):
        strip_set_all(255, 0, 0)
        tone(1000, 200)
        strip_clear()
        time.sleep_ms(800)   # 200ms beep + 800ms gap = 1 second per beep


# ── Full reset ──

def reset_all():
    strip_clear()
    ring_clear()
    buzzer_off()
    motor1_stop()
    motor2_stop()
    laser.off()
    print("System reset. Ready for next rider.")


# ─────────────────────────────────────────
#  MAIN LOOP
# ─────────────────────────────────────────

print("Waiting for rider...")

while True:

    # Always serve web requests while idle
    serve_web()

    # ── STEP 1: Wait for button press (active LOW) ──
    if pb.value() == 0:
        print("Button pressed!")
        time.sleep_ms(50)   # debounce

        # ── STEP 2: Turn on laser, wait for LDR to confirm beam ──
        laser.on()
        print("Laser ON — waiting for LDR beam detection...")

        beam_detected = False
        for _ in range(50):          # wait up to ~5 seconds for beam
            if ldr.value() == 0:     # LDR LOW = beam detected
                beam_detected = True
                break
            serve_web()
            time.sleep_ms(100)

        if not beam_detected:
            print("Beam not detected — aborting. Check laser/LDR alignment.")
            laser.off()
            continue                 # go back to waiting for button

        print("Beam detected! Starting sequence...")

        # ── STEP 3: LED strip + buzzer light show ──
        run_light_show()

        # ── STEP 4: Start 20-second ride timer ──
        print("20-second ride starting!")
        ride_start = time.ticks_ms()

        # ── STEP 5a: Motor 2 starts CW immediately (runs full 20s) ──
        motor2_cw()
        print("Motor 2: CW (full 20s)")

        # ── STEP 5b: Motor 1 one rotation CW + NeoPixel ring fills CW ──
        motor1_cw()
        print("Motor 1: CW (one rotation)")
        ring_fill_cw_ms(MOTOR1_ROTATION_MS)

        # ── STEP 5c: Motor 1 one rotation ACW + NeoPixel ring drains ACW ──
        motor1_acw()
        print("Motor 1: ACW (one rotation)")
        ring_drain_acw_ms(MOTOR1_ROTATION_MS)
        
        motor1_cw()
        print("Motor 1: CW (one rotation)")
        ring_fill_cw_ms(MOTOR1_ROTATION_MS)

        # ── STEP 5c: Motor 1 one rotation ACW + NeoPixel ring drains ACW ──
        motor1_acw()
        print("Motor 1: ACW (one rotation)")
        ring_drain_acw_ms(MOTOR1_ROTATION_MS)
        
        motor1_cw()
        print("Motor 1: CW (one rotation)")
        ring_fill_cw_ms(MOTOR1_ROTATION_MS)

        # ── STEP 5c: Motor 1 one rotation ACW + NeoPixel ring drains ACW ──
        motor1_acw()
        print("Motor 1: ACW (one rotation)")
        ring_drain_acw_ms(MOTOR1_ROTATION_MS)

        # Motor 1 done — stop it
        motor1_stop()
        ring_clear()
        print("Motor 1: stopped. NeoPixel ring off.")

        # ── STEP 6: Wait until second 17, serving web requests ──
        print("Waiting until second 17...")
        while True:
            serve_web()
            elapsed = time.ticks_diff(time.ticks_ms(), ride_start)
            if elapsed >= 17000:
                break
            time.sleep_ms(50)

        # ── STEP 7: Warning at second 17 — light show + 3 beeps ──
        print("WARNING: 3 seconds left!")
        run_warning_beeps()          # takes ~3 seconds (3 x 1s beeps)

        # ── STEP 8: Second 20 — stop everything and reset ──
        motor2_stop()
        laser.off()
        reset_all()
        print("Ride complete!\n")

    time.sleep_ms(20)   # small idle delay to keep loop responsive
